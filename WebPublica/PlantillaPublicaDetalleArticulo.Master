                            <WucBtnTotal:WucBotonTotal runat="server" ID="WucBotonTotal1" />
                        </div>
                    </div>
                    <div class="ui divider"></div>
                    <div class="row">
                        <div class="middle center aligned column">
                            <uc1:WucBusqueda runat="server" ID="WucBusqueda1" />
                        </div>
                    </div>
                </div>
                <div class="ui divider"></div>
            </div>
        </div>
        <div id="t-menu">
